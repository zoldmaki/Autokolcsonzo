<Application x:Class="Autokolcsonzo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:views="clr-namespace:Autokolcsonzo.Views"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#202124"/>
        <SolidColorBrush x:Key="ChromeBrush" Color="#191A1D"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#25262A"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#313237"/>
        <SolidColorBrush x:Key="InputBrush" Color="#292B30"/>
        <SolidColorBrush x:Key="FieldFocusBrush" Color="#393B41"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2D2F34"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#383A41"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#52545B"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#383A3F"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#C7C8CF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EDEDEE"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B6B7BD"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222326"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#A9323D"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FFB1B4"/>
        <SolidColorBrush x:Key="ModalShadeBrush" Color="#610C0D10"/>
        <sys:Double x:Key="FieldHeight">36</sys:Double>
        <Thickness x:Key="FieldPadding">9,0</Thickness>
        <!-- The WPF text view adds a 2 DIP leading inset inside the scroll host. -->
        <Thickness x:Key="TextHostMargin">-2,0,0,0</Thickness>

        <SolidColorBrush x:Key="CalendarViewBackground" Color="#25262A"/>
        <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="#52545B"/>
        <SolidColorBrush x:Key="CalendarViewForeground" Color="#EDEDEE"/>
        <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#222326"/>
        <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="#C7C8CF"/>

        <Geometry x:Key="RouteIcon">M 6,15 H 16 A 3,3 0 0 0 16,9 H 8 A 3,3 0 0 1 8,3 H 15 M 20,3 A 2.5,2.5 0 1 0 15,3 A 2.5,2.5 0 1 0 20,3 M 6,15 A 2.5,2.5 0 1 0 1,15 A 2.5,2.5 0 1 0 6,15</Geometry>
        <Geometry x:Key="CityIcon">M 1,18 V 8 H 5 M 5,18 V 2 H 15 V 18 M 15,6 H 19 V 18 H 1 M 8,6 H 12 M 8,10 H 12 M 8,18 V 14 H 12 V 18</Geometry>
        <Geometry x:Key="TypeIcon">M 1,6 L 10,1 L 19,6 L 10,11 Z M 1,10 L 10,15 L 19,10 M 1,14 L 10,19 L 19,14</Geometry>
        <Geometry x:Key="CarIcon">M 19,10 A 9,9 0 1 0 1,10 A 9,9 0 1 0 19,10 Z M 12.2,10 A 2.2,2.2 0 1 0 7.8,10 A 2.2,2.2 0 1 0 12.2,10 Z M 1.4,7.5 L 8,9 M 18.6,7.5 L 12,9 M 10,12.2 V 19</Geometry>
        <Geometry x:Key="RenterIcon">M 13,5 A 3,3 0 1 1 7,5 A 3,3 0 1 1 13,5 M 4,18 V 16 A 6,6 0 0 1 16,16 V 18 M 16,3 A 3,3 0 0 1 17,9 M 17,12 Q 20,13 20,17</Geometry>
        <Geometry x:Key="RentalIcon">M 2,4 H 18 V 18 H 2 Z M 2,8 H 18 M 6,2 V 6 M 14,2 V 6 M 6,12 H 7 M 10,12 H 11 M 14,12 H 15 M 6,15 H 7 M 10,15 H 11</Geometry>
        <Geometry x:Key="CloseIcon">M 2,2 L 12,12 M 12,2 L 2,12</Geometry>
        <Geometry x:Key="MinimizeIcon">M 1,7 H 13</Geometry>
        <Geometry x:Key="MaximizeIcon">M 2,2 H 12 V 12 H 2 Z</Geometry>
        <Geometry x:Key="RestoreIcon">M 1,4 H 10 V 13 H 1 Z M 4,4 V 1 H 13 V 10 H 10</Geometry>
        <Geometry x:Key="SearchIcon">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 14,14</Geometry>
        <Geometry x:Key="FilterIcon">M 1,2 H 15 M 3,7 H 12 M 6,12 H 9</Geometry>
        <Geometry x:Key="CheckIcon">M 1,5 L 5,9 L 13,1</Geometry>
        <Geometry x:Key="TrashIcon">M 1,4 H 15 M 5,4 V 1 H 11 V 4 M 3,4 V 15 H 13 V 4 M 6,7 V 12 M 10,7 V 12</Geometry>
        <DrawingImage x:Key="RouteImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="{StaticResource RouteIcon}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource FocusBrush}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="WorkspaceWindow" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Language" Value="hu-HU"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="Icon" Value="{StaticResource RouteImage}"/>
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="37" ResizeBorderThickness="5" CornerRadius="10"
                                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource WorkspaceWindow}">
            <Setter Property="Width" Value="500"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="MaxHeight" Value="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="shell:WindowChrome.WindowChrome" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <AdornerDecorator>
                            <Border x:Name="DialogSurface" Background="{StaticResource CanvasBrush}" CornerRadius="12"
                                    Focusable="True" KeyboardNavigation.IsTabStop="False">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="49" Background="{StaticResource RaisedBrush}"
                                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{DynamicResource CaptionButton}" Margin="0,0,8,0"
                                                    AutomationProperties.Name="Bezárás" ToolTip="Bezárás"
                                                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                <Path Data="{StaticResource CloseIcon}" Style="{DynamicResource Glyph}"/>
                                            </Button>
                                            <Border Background="Transparent" MouseLeftButtonDown="DialogTitle_MouseLeftButtonDown">
                                                <TextBlock Text="{TemplateBinding Title}" FontSize="18" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="17,0,8,0" VerticalAlignment="Center"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ContentPresenter Margin="17,14,17,14"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </AdornerDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogActions" TargetType="DockPanel">
            <Setter Property="LastChildFill" Value="False"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="KeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="3" RadiusX="4" RadiusY="4" Stroke="{StaticResource TextBrush}"
                                   StrokeThickness="1" StrokeDashArray="2 2" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="ButtonHover" CornerRadius="5" Background="{TemplateBinding Foreground}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonHover" Property="Opacity" Value="0.20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonHover" Property="Opacity" Value="0.30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="43"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="StrokeThickness" Value="1.45"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource FocusBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
            <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldFrame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{StaticResource TextHostMargin}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="FieldHint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FieldHint" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="FieldFrame" Property="Background" Value="{StaticResource FieldFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldFrame" Property="Opacity" Value="0.54"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
            <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboFrame" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Style="{StaticResource Panel}" Padding="4" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  views:SmoothScrolling.IsEnabled="True"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                        <ScrollViewer.Template>
                                            <ControlTemplate TargetType="ScrollViewer">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                            ContentSource="Content"
                                                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                                               Margin="4,0,0,0" Focusable="False"
                                                               Maximum="{TemplateBinding ScrollableHeight}"
                                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                                               Value="{TemplateBinding VerticalOffset}"
                                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ScrollViewer.Template>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboFrame" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="ComboFrame" Property="Background" Value="{StaticResource FieldFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboFrame" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="views:StableComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4">
                            <Grid>
                                <Border x:Name="ItemAccent" Width="3" Height="16" HorizontalAlignment="Left"
                                        CornerRadius="1.5" Visibility="Collapsed"
                                        Background="{StaticResource FocusBrush}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemAccent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemFrame" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DateInput" TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource FocusBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                          Margin="{StaticResource TextHostMargin}"/>
                            <TextBlock x:Name="DateHint" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=ÉÉÉÉ.HH.NN.}"
                                       Foreground="{StaticResource MutedBrush}" Margin="{TemplateBinding Padding}"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="DateHint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateHint" Property="Text" Value="ÉÉÉÉ.HH.NN."/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
            <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="CalendarStyle" Value="{DynamicResource DefaultCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="DateFrame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="31"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DateInput}"
                                                   Padding="{TemplateBinding Padding}" Tag="{TemplateBinding Tag}"
                                                   AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" MinWidth="0" MinHeight="0"
                                        AutomationProperties.Name="Naptár megnyitása" ToolTip="Naptár">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CalendarIconFrame" Background="Transparent"
                                                    Margin="2" CornerRadius="4">
                                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.3"
                                                      Stroke="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" StrokeLineJoin="Round"
                                                      Data="M1,4 H15 V15 H1 Z M1,7 H15 M5,1 V5 M11,1 V5 M5,10 H6 M10,10 H11"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CalendarIconFrame" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=PART_Root}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DateFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                <Setter TargetName="DateFrame" Property="Background" Value="{StaticResource FieldFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="DateFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DateFrame" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Style="{StaticResource Panel}" Background="{StaticResource RaisedBrush}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,10"
                                                  TextBlock.FontWeight="SemiBold" RecognizesAccessKey="True"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
