<Window x:Class="Autokolcsonzo.Views.VarosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Város" Width="430" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <StackPanel>
        <TextBlock Text="Név" Style="{StaticResource DialogLabel}" Margin="0,0,0,5"/>
        <TextBox x:Name="NevTextBox" AutomationProperties.Name="Név" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Irányítószám" Style="{StaticResource DialogLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="IranySzamTextBox" AutomationProperties.Name="Irányítószám" MaxLength="4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Megye" Style="{StaticResource DialogLabel}" Margin="0,0,0,5"/>
                <TextBox x:Name="MegyeTextBox" AutomationProperties.Name="Megye"/>
            </StackPanel>
        </Grid>

        <DockPanel Style="{StaticResource DialogActions}">
            <Button DockPanel.Dock="Left" Content="Mégse" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Mentés" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Mentes_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
