<Window x:Class="Autokolcsonzo.Views.VarosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Város" Height="184" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Név:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="NevTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Irányítószám:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="IranySzamTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" MaxLength="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Megye:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="MegyeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Mentés" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Mentes_Click"/>
            <Button Content="Mégse" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>