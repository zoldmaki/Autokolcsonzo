<Window x:Class="Autokolcsonzo.Views.AutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Autokolcsonzo.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autó" Width="500" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="124"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Típus:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <views:StableComboBox x:Name="TipusComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                  DisplayMemberPath="Megnevezes"/>

        <TextBlock Grid.Row="1" Text="Alap km:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="AlapKmTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Napi ár (Ft):" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="NapiArTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Megtett km:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="MegtettKmTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                 Style="{StaticResource ReadOnlyField}" AutomationProperties.Name="Megtett km"
                 Text="Alap km + a bérlések km-e"/>

        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource DialogActions}">
            <Button DockPanel.Dock="Left" Content="Mégse" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Mentés" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Mentes_Click"/>
        </DockPanel>
    </Grid>
</Window>
