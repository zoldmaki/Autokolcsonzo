<Window x:Class="Autokolcsonzo.Views.AutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autó" Height="231" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Típus:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox x:Name="TipusComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                  DisplayMemberPath="Megnevezes"/>

        <TextBlock Grid.Row="1" Text="Alap km:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="AlapKmTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Napi ár (Ft):" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="NapiArTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Megtett km:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBlock x:Name="MegtettKmTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                   VerticalAlignment="Center" Text="(az alap km és a bérlések km-einek összege)"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Mentés" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Mentes_Click"/>
            <Button Content="Mégse" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>