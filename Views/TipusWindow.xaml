<Window x:Class="Autokolcsonzo.Views.TipusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Autokolcsonzo"
        Title="Típus" Width="470" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}" local:App.Accent="{DynamicResource TipusAccent}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="124"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Márka:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="MarkaTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Modell:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="ModellTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Évjárat:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="EvjaratTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" MaxLength="4"/>

        <TextBlock Grid.Row="3" Text="Fogyasztás:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <TextBox x:Name="FogyasztasTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                 ToolTip="l vagy kWh / 100 km"/>

        <TextBlock Grid.Row="4" Text="Üzemanyag:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
        <ComboBox x:Name="UzemanyagComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource DialogActions}">
            <Button Content="Mégse" Style="{StaticResource QuietButton}" IsCancel="True"/>
            <Button Content="Mentés" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="Mentes_Click"/>
        </StackPanel>
    </Grid>
</Window>
