<Window x:Class="Autokolcsonzo.Views.TipusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Típus" Height="256" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Márka:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="MarkaTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Modell:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="ModellTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Évjárat:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="EvjaratTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" MaxLength="4"/>

        <TextBlock Grid.Row="3" Text="Fogyasztás:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <TextBox x:Name="FogyasztasTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                 ToolTip="l vagy kWh / 100 km"/>

        <TextBlock Grid.Row="4" Text="Üzemanyag:" Margin="0,0,12,10" VerticalAlignment="Center"/>
        <ComboBox x:Name="UzemanyagComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Mentés" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Mentes_Click"/>
            <Button Content="Mégse" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>