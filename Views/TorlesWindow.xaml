<Window x:Class="Autokolcsonzo.Views.TorlesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Autokolcsonzo.Views"
        Style="{StaticResource DialogWindow}" Width="440" WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True" FocusManager.FocusedElement="{Binding ElementName=MegseGomb}">
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="MegseGomb" Content="Mégse" IsCancel="True" HorizontalAlignment="Left"/>
            <Button x:Name="TorlesGomb" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Click="Torles_Click"
                    AutomationProperties.Name="Törlés">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource TrashIcon}" Margin="0,0,7,0"/>
                    <TextBlock Text="Törlés"/>
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel>
            <TextBlock x:Name="Kerdes" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                <ScrollViewer x:Name="AdatokGorgeto" MaxHeight="235" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Focusable="False" views:SmoothScrolling.IsEnabled="True">
                    <ItemsControl x:Name="Adatok">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="11,8">
                                    <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top"
                                          StrokeThickness="1.45" StrokeLineJoin="Round" Margin="0,2,10,0"
                                          Stroke="{StaticResource MutedBrush}"
                                          Data="{Binding Tag.Ikon, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nev}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Reszlet}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <Border x:Name="KapcsolodoPanel" Background="{StaticResource CanvasBrush}"
                                                Padding="9,7" CornerRadius="5" Margin="0,9,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="KapcsolatokCim"
                                                           Text="{Binding Tag.KapcsolatokTobbesSzama, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3"/>
                                                <ItemsControl x:Name="KapcsolodoLista" ItemsSource="{Binding KapcsolodoSorok}"
                                                              Tag="{Binding Tag.KapcsolatokIkonja, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,5,0,4">
                                                                <Path DockPanel.Dock="Left"
                                                                      Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      Style="{StaticResource Glyph}" Stroke="{StaticResource MutedBrush}"
                                                                      VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Nev}" TextWrapping="Wrap"
                                                                               FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Reszlet}" TextWrapping="Wrap" FontSize="12"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding KapcsolodoSorokSzama}" Value="1">
                                        <Setter TargetName="KapcsolatokCim" Property="Text"
                                                Value="{Binding Tag.KapcsolatokEgyesSzama, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=KapcsolodoLista}" Value="False">
                                        <Setter TargetName="KapcsolodoPanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="Kovetkezmeny" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
