<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Autokolcsonzo.Views">
    <Style TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="148"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,1,0" Padding="10,16">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                          ContentSource="SelectedContent" Margin="24,20,24,16"
                                          KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Frame" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{TemplateBinding Tag}" Style="{StaticResource Glyph}"
                                  Stroke="{TemplateBinding Foreground}" Width="16" Height="16" Margin="0,0,9,0"/>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,2">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource SearchIcon}" Style="{StaticResource Glyph}"
                                  Stroke="{StaticResource MutedBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                              Margin="{StaticResource TextHostMargin}"/>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource FieldFocusBrush}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="views:WorkspaceFilterPanel">
        <Setter Property="Margin" Value="0,15,0,12"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:WorkspaceFilterPanel">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton x:Name="FilterButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                                          Style="{StaticResource FilterToggle}" AutomationProperties.Name="Szűrők">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource FilterIcon}" Margin="0,0,7,0"/>
                                    <TextBlock Text="Szűrők" VerticalAlignment="Center"/>
                                    <Border x:Name="Count" Background="{StaticResource ChromeBrush}" CornerRadius="4"
                                            Width="21" Height="19" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding ActiveFilterCount, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter ContentSource="Header"/>
                        </DockPanel>
                        <Border x:Name="AdvancedPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                                Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <ScrollViewer Margin="12,10,12,2" MaxHeight="176" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              HorizontalContentAlignment="Stretch" Focusable="False">
                                    <ContentPresenter/>
                                </ScrollViewer>
                                <Button x:Name="ResetButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0"
                                        Style="{StaticResource IconButton}" IsEnabled="{TemplateBinding HasActiveFilters}"
                                        AutomationProperties.Name="Szűrés törlése" ToolTip="Szűrés törlése"
                                        Command="{x:Static views:WorkspaceFilterPanel.ResetCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Style="{StaticResource Glyph}" Data="{StaticResource CloseIcon}" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="FilterButton" Property="IsChecked" Value="True">
                            <Setter TargetName="AdvancedPanel" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ActiveFilterCount" Value="0">
                            <Setter TargetName="Count" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColumnHeaderResizeHandle" TargetType="Thumb">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="9,6,8,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="views:ColumnHeaderSizing.FitCaption" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Grid RenderTransform="{Binding Column.(views:ColumnDragFeedback.Translation), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Static Transform.Identity}}">
                            <Border x:Name="HeaderFrame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    Tag="{Binding Column.(views:ColumnDragFeedback.State), RelativeSource={RelativeSource TemplatedParent}}">
                                <StackPanel Orientation="Horizontal" ClipToBounds="True">
                                    <ContentPresenter x:Name="HeaderCaption" VerticalAlignment="Center"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <Grid x:Name="SortSlot" Width="13">
                                        <Path x:Name="SortArrow" Style="{StaticResource Glyph}" Width="9" Height="9"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Stroke="{StaticResource FocusBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Style="{StaticResource ColumnHeaderResizeHandle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Style="{StaticResource ColumnHeaderResizeHandle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger SourceName="PART_LeftHeaderGripper" Property="IsDragging" Value="True">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger SourceName="PART_RightHeaderGripper" Property="IsDragging" Value="True">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="CanUserSort" Value="False">
                            <Setter TargetName="SortSlot" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4 M 4,0 V 8"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,8 L 8,4 M 4,8 V 0"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, ElementName=HeaderFrame}" Value="{x:Static views:ColumnPreviewState.Shifted}">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, ElementName=HeaderFrame}" Value="{x:Static views:ColumnPreviewState.Dragged}">
                            <Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource OutlineBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid RenderTransform="{Binding Column.(views:ColumnDragFeedback.Translation), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Static Transform.Identity}}">
                        <Grid x:Name="CellVisual"
                              Background="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}, FallbackValue={StaticResource CanvasBrush}}">
                            <Border x:Name="CellFrame" Background="Transparent" Padding="{TemplateBinding Padding}"
                                    Tag="{Binding Column.(views:ColumnDragFeedback.State), RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, ElementName=CellFrame}" Value="{x:Static views:ColumnPreviewState.Shifted}">
                            <Setter TargetName="CellFrame" Property="Background" Value="#10C7C8CF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, ElementName=CellFrame}" Value="{x:Static views:ColumnPreviewState.Dragged}">
                            <Setter TargetName="CellFrame" Property="Background" Value="#24C7C8CF"/>
                            <Setter Property="Panel.ZIndex" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectionMarkCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="TableText" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <DataTemplate x:Key="SelectionMark">
        <Path x:Name="Check" Data="{StaticResource CheckIcon}" Style="{StaticResource Glyph}"
              Width="11" Height="10" Stroke="{StaticResource FocusBrush}" Visibility="Hidden"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="{StaticResource CanvasBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="views:ColumnDragFeedback.IsEnabled" Value="True"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="MinColumnWidth" Value="60"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="views:SmoothScrolling.IsEnabled" Value="True"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="FrozenColumnCount" Value="1"/>
    </Style>

    <Style x:Key="SelectionCount" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItems.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EditSelection" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="IsEnabled" Value="False"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItems.Count}" Value="1">
                <Setter Property="IsEnabled" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeleteSelection" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItems.Count}" Value="0">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SzuroMezo" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,9,10"/>
    </Style>
    <Style x:Key="SzuroCimke" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="RugalmasSzuroMezo" TargetType="StackPanel" BasedOn="{StaticResource SzuroMezo}">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="MinWidth" Value="112"/>
    </Style>
    <Style x:Key="SzuroTartomany" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
        <Setter Property="Background" Value="{StaticResource InputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SzuroSzamHatar" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SzuroSzamMin" TargetType="TextBox" BasedOn="{StaticResource SzuroSzamHatar}">
        <Setter Property="Tag" Value="Min."/>
    </Style>
    <Style x:Key="SzuroSzamMax" TargetType="TextBox" BasedOn="{StaticResource SzuroSzamHatar}">
        <Setter Property="Tag" Value="Max."/>
    </Style>
    <Style x:Key="SzuroDatum" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SzuroElvalaszto" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Background" Value="{StaticResource OutlineBrush}"/>
    </Style>
</ResourceDictionary>
