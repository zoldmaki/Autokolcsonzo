<Window x:Class="Autokolcsonzo.Views.BerloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bérlő" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Név:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <TextBox x:Name="NevTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Text="Születési dátum:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <DatePicker x:Name="SzulDatumPicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Text="Város:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="VarosComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                      DisplayMemberPath="Nev"/>

            <TextBlock Grid.Row="3" Text="Utca:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <TextBox x:Name="UtcaTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="Házszám:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <TextBox x:Name="HazSzamTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>
        </Grid>

        <GroupBox x:Name="ElsoBerlesGroupBox" Header="Első bérlés (új bérlőnél kötelező)"
          Margin="0,4,0,12" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Autó:" Margin="0,0,12,8" VerticalAlignment="Center"/>
                <ComboBox x:Name="ElsoAutoComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                  DisplayMemberPath="Megnevezes"/>

                <TextBlock Grid.Row="1" Text="Kezdő dátum:" Margin="0,0,12,8" VerticalAlignment="Center"/>
                <DatePicker x:Name="ElsoKezdoDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Text="Vég dátum:" Margin="0,0,12,8" VerticalAlignment="Center"/>
                <DatePicker x:Name="ElsoVegDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                    ToolTip="Hagyja üresen, ha a bérlés még tart"
                    SelectedDateChanged="ElsoVegDatePicker_SelectedDateChanged"/>

                <TextBlock Grid.Row="3" Text="Megtett km:" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ElsoKmTextBox" Grid.Row="3" Grid.Column="1" IsEnabled="False"
                 ToolTip="Csak lezárult bérlésnél adható meg"/>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Mentés" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Mentes_Click"/>
            <Button Content="Mégse" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>