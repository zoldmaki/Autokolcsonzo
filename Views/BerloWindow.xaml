<Window x:Class="Autokolcsonzo.Views.BerloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Autokolcsonzo"
        Title="Bérlő" Width="520" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}" local:App.Accent="{DynamicResource BerloAccent}">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="124"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Név:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
            <TextBox x:Name="NevTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Text="Születési dátum:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
            <DatePicker x:Name="SzulDatumPicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Text="Város:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
            <ComboBox x:Name="VarosComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                      DisplayMemberPath="Nev"/>

            <TextBlock Grid.Row="3" Text="Utca:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
            <TextBox x:Name="UtcaTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="Házszám:" Style="{StaticResource DialogLabel}" Margin="0,0,12,10"/>
            <TextBox x:Name="HazSzamTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>
        </Grid>

        <GroupBox x:Name="ElsoBerlesGroupBox" Header="Első bérlés (új bérlőnél kötelező)"
          Margin="0,4,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Autó:" Style="{StaticResource DialogLabel}" Margin="0,0,12,8"/>
                <ComboBox x:Name="ElsoAutoComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                  DisplayMemberPath="Megnevezes"/>

                <TextBlock Grid.Row="1" Text="Kezdő dátum:" Style="{StaticResource DialogLabel}" Margin="0,0,12,8"/>
                <DatePicker x:Name="ElsoKezdoDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Text="Vég dátum:" Style="{StaticResource DialogLabel}" Margin="0,0,12,8"/>
                <DatePicker x:Name="ElsoVegDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                    ToolTip="Hagyja üresen, ha a bérlés még tart"
                    SelectedDateChanged="ElsoVegDatePicker_SelectedDateChanged"/>

                <TextBlock Grid.Row="3" Text="Megtett km:" Style="{StaticResource DialogLabel}" Margin="0,0,12,0"/>
                <TextBox x:Name="ElsoKmTextBox" Grid.Row="3" Grid.Column="1" IsEnabled="False"
                 ToolTip="Csak lezárult bérlésnél adható meg"/>
            </Grid>
        </GroupBox>

        <StackPanel Style="{StaticResource DialogActions}">
            <Button Content="Mégse" Style="{StaticResource QuietButton}" IsCancel="True"/>
            <Button Content="Mentés" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="Mentes_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
