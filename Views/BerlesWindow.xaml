<Window x:Class="Autokolcsonzo.Views.BerlesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bérlés" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Bérlő:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="BerloComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                      DisplayMemberPath="Megnevezes"/>

            <TextBlock Grid.Row="1" Text="Autó:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="AutoComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                      DisplayMemberPath="Megnevezes"/>

            <TextBlock Grid.Row="2" Text="Kezdő dátum:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <DatePicker x:Name="KezdoDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Text="Vég dátum:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <DatePicker x:Name="VegDatePicker" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                        ToolTip="Hagyja üresen, ha a bérlés még tart"
                        SelectedDateChanged="VegDatePicker_SelectedDateChanged"/>

            <TextBlock Grid.Row="4" Text="Megtett km:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <TextBox x:Name="KmTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" IsEnabled="False"
                     ToolTip="Csak lezárult bérlésnél adható meg"/>

            <TextBlock Grid.Row="5" Text="Számla:" Margin="0,0,12,10" VerticalAlignment="Center"/>
            <TextBlock x:Name="SzamlaTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                       VerticalAlignment="Center" Text="(automatikusan generálódik)"/>
        </Grid>

        <TextBlock x:Name="ZarolasTextBlock" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="Collapsed"
                   Text="A bérlő, az autó és a kezdő dátum a bérlés azonosítója, ezért nem módosítható. Hibás adatnál törölje a bérlést, és vegye fel újra."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Mentés" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Mentes_Click"/>
            <Button Content="Mégse" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>