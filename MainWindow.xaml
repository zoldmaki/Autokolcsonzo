<Window x:Class="Autokolcsonzo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Autokolcsonzo.Views"
        Title="Autókölcsönző" Height="740" Width="1220" MinHeight="610" MinWidth="790"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WorkspaceWindow}">

    <Window.Resources>
        <ResourceDictionary Source="Views/WorkspaceStyles.xaml"/>
    </Window.Resources>

    <Border x:Name="WorkspaceSurface" Background="{StaticResource CanvasBrush}"
            Focusable="True" KeyboardNavigation.IsTabStop="False">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="42" Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                                AutomationProperties.Name="Kis méret" ToolTip="Kis méret">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource MinimizeIcon}" Width="11"/>
                        </Button>
                        <Button Click="MaximizeRestore_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                    <Setter Property="AutomationProperties.Name" Value="Teljes méret"/>
                                    <Setter Property="ToolTip" Value="Teljes méret"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="AutomationProperties.Name" Value="Előző méret"/>
                                            <Setter Property="ToolTip" Value="Előző méret"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="11" Height="11">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="Data" Value="{StaticResource MaximizeIcon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Data" Value="{StaticResource RestoreIcon}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                                AutomationProperties.Name="Bezárás" ToolTip="Bezárás">
                            <Path Style="{StaticResource Glyph}" Data="{StaticResource CloseIcon}" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                        <Image Source="{StaticResource RouteImage}" Width="18" Height="18" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="WorkspaceTabs" SelectionChanged="FoTabControl_SelectionChanged">

                <TabItem Header="Városok" Tag="{StaticResource CityIcon}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UjVaros_Click"
                                    Content="+  Új város" AutomationProperties.Name="Új város"/>
                            <TextBlock Text="Városok" Style="{StaticResource WorkspaceTitle}"/>
                        </DockPanel>

                        <views:WorkspaceFilterPanel x:Name="VarosFilters" Grid.Row="1" FiltersReset="VarosFilter_Changed">
                            <views:WorkspaceFilterPanel.Header>
                                <TextBox x:Name="VarosSearch" Style="{StaticResource SearchBox}" Tag="Név, irányítószám vagy megye"
                                         AutomationProperties.Name="Városok keresése" TextChanged="VarosFilter_Changed"/>
                            </views:WorkspaceFilterPanel.Header>
                            <UniformGrid Columns="4">
                                <StackPanel Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Város neve" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="VarosNevFilterTextBox"
                                             AutomationProperties.Name="Város neve" TextChanged="VarosFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Irányítószám" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="VarosIranySzamFilterTextBox"
                                             AutomationProperties.Name="Irányítószám" TextChanged="VarosFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Megye" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="VarosMegyeFilterTextBox"
                                             AutomationProperties.Name="Megye" TextChanged="VarosFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SzuroMezo}" Margin="0,0,0,10">
                                    <TextBlock Text="Bérlők száma" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="VarosBerlokMin" AutomationProperties.Name="Bérlők száma, minimum" TextChanged="VarosFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="VarosBerlokMax" AutomationProperties.Name="Bérlők száma, maximum" TextChanged="VarosFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                        </views:WorkspaceFilterPanel>

                        <DataGrid Grid.Row="2" x:Name="VarosDataGrid"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MouseDoubleClick="VarosDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="23" MinWidth="23" CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                                        CellStyle="{StaticResource SelectionMarkCell}" CellTemplate="{StaticResource SelectionMark}"/>
                                <DataGridTextColumn Header="Azonosító"    Binding="{Binding VarosId}"/>
                                <DataGridTextColumn Header="Név"          Binding="{Binding Nev}" Width="*"/>
                                <DataGridTextColumn Header="Irányítószám" Binding="{Binding IranySzam}"/>
                                <DataGridTextColumn Header="Megye"        Binding="{Binding Megye}" Width="*"/>
                                <DataGridTextColumn Header="Bérlők száma" Binding="{Binding Berlok.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"
                                   DataContext="{Binding ElementName=VarosDataGrid}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Items.Count, StringFormat={}{0} találat}"/>
                                <TextBlock Style="{StaticResource SelectionCount}"
                                           Text="{Binding SelectedItems.Count, StringFormat={}·  {0} kijelölve}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Törlés" Style="{StaticResource DeleteSelection}" Click="TorolVaros_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource EditSelection}" MinWidth="105"
                                        Margin="8,0,0,0" Click="SzerkesztVaros_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Típusok" Tag="{StaticResource TypeIcon}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UjTipus_Click"
                                    Content="+  Új típus" AutomationProperties.Name="Új típus"/>
                            <TextBlock Text="Típusok" Style="{StaticResource WorkspaceTitle}"/>
                        </DockPanel>

                        <views:WorkspaceFilterPanel x:Name="TipusFilters" Grid.Row="1" FiltersReset="TipusFilter_Changed">
                            <views:WorkspaceFilterPanel.Header>
                                <TextBox x:Name="TipusSearch" Style="{StaticResource SearchBox}" Tag="Márka, modell vagy üzemanyag"
                                         AutomationProperties.Name="Típusok keresése" TextChanged="TipusFilter_Changed"/>
                            </views:WorkspaceFilterPanel.Header>
                            <views:FillWrapPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Márka" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="TipusMarkaFilterTextBox"
                                             AutomationProperties.Name="Márka" TextChanged="TipusFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Modell" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="TipusModellFilterTextBox"
                                             AutomationProperties.Name="Modell" TextChanged="TipusFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Évjárat" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="TipusEvjaratMin"
                                              AutomationProperties.Name="Évjárat, minimum" TextChanged="TipusFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="TipusEvjaratMax"
                                              AutomationProperties.Name="Évjárat, maximum" TextChanged="TipusFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Fogyasztás (/100 km)" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="TipusFogyasztasMin"
                                              AutomationProperties.Name="Fogyasztás (/100 km), minimum" TextChanged="TipusFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="TipusFogyasztasMax"
                                              AutomationProperties.Name="Fogyasztás (/100 km), maximum" TextChanged="TipusFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Üzemanyag" Style="{StaticResource SzuroCimke}"/>
                                    <views:StableComboBox x:Name="TipusUzemanyagFilterComboBox"
                                              AutomationProperties.Name="Üzemanyag" SelectionChanged="UzemanyagFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Autók száma" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="TipusAutokMin"
                                              AutomationProperties.Name="Autók száma, minimum" TextChanged="TipusFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="TipusAutokMax"
                                              AutomationProperties.Name="Autók száma, maximum" TextChanged="TipusFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </views:FillWrapPanel>
                        </views:WorkspaceFilterPanel>

                        <DataGrid Grid.Row="2" x:Name="TipusDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="TipusDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="23" MinWidth="23" CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                                        CellStyle="{StaticResource SelectionMarkCell}" CellTemplate="{StaticResource SelectionMark}"/>
                                <DataGridTextColumn Header="Azonosító" Binding="{Binding TipusId}"/>
                                <DataGridTextColumn Header="Márka"     Binding="{Binding Marka}" Width="*"/>
                                <DataGridTextColumn Header="Modell"    Binding="{Binding Modell}" Width="*"/>
                                <DataGridTextColumn Header="Évjárat"   Binding="{Binding Evjarat}"/>
                                <DataGridTextColumn Header="Fogyasztás (/100 km)"
                                            Binding="{Binding Fogyasztas, StringFormat=N1, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Üzemanyag" Binding="{Binding Uzemanyag}"/>
                                <DataGridTextColumn Header="Autók száma" Binding="{Binding Autok.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"
                                   DataContext="{Binding ElementName=TipusDataGrid}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Items.Count, StringFormat={}{0} találat}"/>
                                <TextBlock Style="{StaticResource SelectionCount}"
                                           Text="{Binding SelectedItems.Count, StringFormat={}·  {0} kijelölve}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Törlés" Style="{StaticResource DeleteSelection}" Click="TorolTipus_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource EditSelection}" MinWidth="105"
                                        Margin="8,0,0,0" Click="SzerkesztTipus_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Autók" Tag="{StaticResource CarIcon}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UjAuto_Click"
                                    Content="+  Új autó" AutomationProperties.Name="Új autó"/>
                            <TextBlock Text="Autók" Style="{StaticResource WorkspaceTitle}"/>
                        </DockPanel>

                        <views:WorkspaceFilterPanel x:Name="AutoFilters" Grid.Row="1" FiltersReset="AutoFilter_Changed">
                            <views:WorkspaceFilterPanel.Header>
                                <TextBox x:Name="AutoSearch" Style="{StaticResource SearchBox}" Tag="Azonosító, márka vagy modell"
                                         AutomationProperties.Name="Autók keresése" TextChanged="AutoFilter_Changed"/>
                            </views:WorkspaceFilterPanel.Header>
                            <views:FillWrapPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Márka" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="AutoMarkaFilterTextBox"
                                             AutomationProperties.Name="Márka" TextChanged="AutoFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Modell" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="AutoModellFilterTextBox"
                                             AutomationProperties.Name="Modell" TextChanged="AutoFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Évjárat" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="AutoEvjaratMin"
                                              AutomationProperties.Name="Évjárat, minimum" TextChanged="AutoFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="AutoEvjaratMax"
                                              AutomationProperties.Name="Évjárat, maximum" TextChanged="AutoFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Alap km" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="AutoAlapKmMin"
                                              AutomationProperties.Name="Alap km, minimum" TextChanged="AutoFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="AutoAlapKmMax"
                                              AutomationProperties.Name="Alap km, maximum" TextChanged="AutoFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Megtett km" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="AutoMegtettKmMin"
                                              AutomationProperties.Name="Megtett km, minimum" TextChanged="AutoFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="AutoMegtettKmMax"
                                              AutomationProperties.Name="Megtett km, maximum" TextChanged="AutoFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Napi ár (Ft)" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="AutoArMin"
                                              AutomationProperties.Name="Napi ár (Ft), minimum" TextChanged="AutoFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="AutoArMax"
                                              AutomationProperties.Name="Napi ár (Ft), maximum" TextChanged="AutoFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Bérlések száma" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="AutoBerlesekMin"
                                              AutomationProperties.Name="Bérlések száma, minimum" TextChanged="AutoFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="AutoBerlesekMax"
                                              AutomationProperties.Name="Bérlések száma, maximum" TextChanged="AutoFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </views:FillWrapPanel>
                        </views:WorkspaceFilterPanel>

                        <DataGrid Grid.Row="2" x:Name="AutoDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="AutoDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="23" MinWidth="23" CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                                        CellStyle="{StaticResource SelectionMarkCell}" CellTemplate="{StaticResource SelectionMark}"/>
                                <DataGridTextColumn Header="Azonosító" Binding="{Binding AutoId}"/>
                                <DataGridTextColumn Header="Márka"     Binding="{Binding Tipus.Marka}" Width="*"/>
                                <DataGridTextColumn Header="Modell"    Binding="{Binding Tipus.Modell}" Width="*"/>
                                <DataGridTextColumn Header="Évjárat"   Binding="{Binding Tipus.Evjarat}"/>
                                <DataGridTextColumn Header="Alap km"   Binding="{Binding AlapKm, StringFormat=N0, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Megtett km" Binding="{Binding MegtettKm, StringFormat=N0, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Napi ár (Ft)" Binding="{Binding NapiAr, StringFormat=N0, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Bérlések" Binding="{Binding Berlesek.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"
                                   DataContext="{Binding ElementName=AutoDataGrid}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Items.Count, StringFormat={}{0} találat}"/>
                                <TextBlock Style="{StaticResource SelectionCount}"
                                           Text="{Binding SelectedItems.Count, StringFormat={}·  {0} kijelölve}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Törlés" Style="{StaticResource DeleteSelection}" Click="TorolAuto_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource EditSelection}" MinWidth="105"
                                        Margin="8,0,0,0" Click="SzerkesztAuto_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Bérlők" Tag="{StaticResource RenterIcon}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UjBerlo_Click"
                                    Content="+  Új bérlő" AutomationProperties.Name="Új bérlő"/>
                            <TextBlock Text="Bérlők" Style="{StaticResource WorkspaceTitle}"/>
                        </DockPanel>

                        <views:WorkspaceFilterPanel x:Name="BerloFilters" Grid.Row="1" FiltersReset="BerloFilter_Changed">
                            <views:WorkspaceFilterPanel.Header>
                                <TextBox x:Name="BerloSearch" Style="{StaticResource SearchBox}" Tag="Név, város vagy utca"
                                         AutomationProperties.Name="Bérlők keresése" TextChanged="BerloFilter_Changed"/>
                            </views:WorkspaceFilterPanel.Header>
                            <views:FillWrapPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}">
                                    <TextBlock Text="Név" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerloNevFilterTextBox"
                                             AutomationProperties.Name="Név" TextChanged="BerloFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="275">
                                    <TextBlock Text="Születési dátum" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Style="{StaticResource SzuroDatum}" Tag="Ettől" x:Name="BerloSzulDatumMin"
                                              AutomationProperties.Name="Születési dátum, ettől" SelectedDateChanged="BerloFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <DatePicker Grid.Column="2" Style="{StaticResource SzuroDatum}" Tag="Eddig" x:Name="BerloSzulDatumMax"
                                              AutomationProperties.Name="Születési dátum, eddig" SelectedDateChanged="BerloFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Életkor" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="BerloEletkorMin"
                                              AutomationProperties.Name="Életkor, minimum" TextChanged="BerloFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="BerloEletkorMax"
                                              AutomationProperties.Name="Életkor, maximum" TextChanged="BerloFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="100">
                                    <TextBlock Text="Város" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerloVarosFilterTextBox"
                                             AutomationProperties.Name="Város" TextChanged="BerloFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="104">
                                    <TextBlock Text="Utca" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerloUtcaFilterTextBox"
                                             AutomationProperties.Name="Utca" TextChanged="BerloFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="70">
                                    <TextBlock Text="Házszám" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerloHazSzamFilterTextBox"
                                             AutomationProperties.Name="Házszám" TextChanged="BerloFilter_Changed"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RugalmasSzuroMezo}" MinWidth="123">
                                    <TextBlock Text="Bérlések száma" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="BerloBerlesekMin"
                                              AutomationProperties.Name="Bérlések száma, minimum" TextChanged="BerloFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="BerloBerlesekMax"
                                              AutomationProperties.Name="Bérlések száma, maximum" TextChanged="BerloFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </views:FillWrapPanel>
                        </views:WorkspaceFilterPanel>

                        <DataGrid Grid.Row="2" x:Name="BerloDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="BerloDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="23" MinWidth="23" CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                                        CellStyle="{StaticResource SelectionMarkCell}" CellTemplate="{StaticResource SelectionMark}"/>
                                <DataGridTextColumn Header="Azonosító" Binding="{Binding BerloId}"/>
                                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                                <DataGridTextColumn Header="Születési dátum" Binding="{Binding SzulDatum, StringFormat=yyyy.MM.dd}"/>
                                <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor}"/>
                                <DataGridTextColumn Header="Város" Binding="{Binding Varos.Nev}" Width="*"/>
                                <DataGridTextColumn Header="Utca" Binding="{Binding UtcaNev}" Width="*"/>
                                <DataGridTextColumn Header="Házszám" Binding="{Binding HazSzam}"/>
                                <DataGridTextColumn Header="Bérlések" Width="79" Binding="{Binding Berlesek.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"
                                   DataContext="{Binding ElementName=BerloDataGrid}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Items.Count, StringFormat={}{0} találat}"/>
                                <TextBlock Style="{StaticResource SelectionCount}"
                                           Text="{Binding SelectedItems.Count, StringFormat={}·  {0} kijelölve}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Törlés" Style="{StaticResource DeleteSelection}" Click="TorolBerlo_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource EditSelection}" MinWidth="105"
                                        Margin="8,0,0,0" Click="SzerkesztBerlo_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Bérlések" Tag="{StaticResource RentalIcon}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UjBerles_Click"
                                    Content="+  Új bérlés" AutomationProperties.Name="Új bérlés"/>
                            <TextBlock Text="Bérlések" Style="{StaticResource WorkspaceTitle}"/>
                        </DockPanel>

                        <views:WorkspaceFilterPanel x:Name="BerlesFilters" Grid.Row="1" FiltersReset="BerlesFilter_Changed"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <views:WorkspaceFilterPanel.Header>
                                <TextBox x:Name="BerlesSearch" Style="{StaticResource SearchBox}" Tag="Számla, bérlő, márka vagy modell"
                                         AutomationProperties.Name="Bérlések keresése" TextChanged="BerlesFilter_Changed"/>
                            </views:WorkspaceFilterPanel.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" MinWidth="284"/>
                                    <ColumnDefinition Width="1.6*" MinWidth="284"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Számla" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerlesSzamlaFilterTextBox" AutomationProperties.Name="Számla"
                                             TextChanged="BerlesFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Bérlő" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerlesBerloFilterTextBox" AutomationProperties.Name="Bérlő"
                                             TextChanged="BerlesFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Márka" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerlesMarkaFilterTextBox" AutomationProperties.Name="Márka"
                                             TextChanged="BerlesFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Modell" Style="{StaticResource SzuroCimke}"/>
                                    <TextBox x:Name="BerlesModellFilterTextBox" AutomationProperties.Name="Modell"
                                             TextChanged="BerlesFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Style="{StaticResource SzuroMezo}" Margin="0,0,0,10">
                                    <TextBlock Text="Állapot" Style="{StaticResource SzuroCimke}"/>
                                    <views:StableComboBox x:Name="BerlesAllapotFilterComboBox" AutomationProperties.Name="Állapot"
                                                          SelectionChanged="AllapotFilter_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Kezdő dátum" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="BerlesKezdoDatumMin" Style="{StaticResource SzuroDatum}" Tag="Ettől"
                                                        AutomationProperties.Name="Kezdő dátum, ettől" SelectedDateChanged="BerlesFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <DatePicker Grid.Column="2" x:Name="BerlesKezdoDatumMax" Style="{StaticResource SzuroDatum}" Tag="Eddig"
                                                        AutomationProperties.Name="Kezdő dátum, eddig" SelectedDateChanged="BerlesFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Vég dátum" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Style="{StaticResource SzuroDatum}" Tag="Ettől" x:Name="BerlesVegDatumMin" AutomationProperties.Name="Vég dátum, ettől"
                                              SelectedDateChanged="BerlesFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <DatePicker Grid.Column="2" Style="{StaticResource SzuroDatum}" Tag="Eddig" x:Name="BerlesVegDatumMax" AutomationProperties.Name="Vég dátum, eddig"
                                              SelectedDateChanged="BerlesFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Ár (Ft)" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="BerlesArMin" AutomationProperties.Name="Ár (Ft), minimum"
                                              TextChanged="BerlesFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="BerlesArMax" AutomationProperties.Name="Ár (Ft), maximum"
                                              TextChanged="BerlesFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource SzuroMezo}">
                                    <TextBlock Text="Megtett km" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="BerlesKmMin" AutomationProperties.Name="Megtett km, minimum"
                                              TextChanged="BerlesFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="BerlesKmMax" AutomationProperties.Name="Megtett km, maximum"
                                              TextChanged="BerlesFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="4" Style="{StaticResource SzuroMezo}" Margin="0,0,0,10">
                                    <TextBlock Text="Hossz (nap)" Style="{StaticResource SzuroCimke}"/>
                                    <Border Style="{StaticResource SzuroTartomany}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SzuroSzamMin}" x:Name="BerlesHosszMin" AutomationProperties.Name="Hossz (nap), minimum"
                                              TextChanged="BerlesFilter_Changed"/>
                                            <Border Grid.Column="1" Style="{StaticResource SzuroElvalaszto}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource SzuroSzamMax}" x:Name="BerlesHosszMax" AutomationProperties.Name="Hossz (nap), maximum"
                                              TextChanged="BerlesFilter_Changed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </views:WorkspaceFilterPanel>

                        <DataGrid Grid.Row="2" x:Name="BerlesDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="BerlesDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="23" MinWidth="23" CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                                        CellStyle="{StaticResource SelectionMarkCell}" CellTemplate="{StaticResource SelectionMark}"/>
                                <DataGridTextColumn Header="Számla" Width="102" Binding="{Binding Szamla}"/>
                                <DataGridTextColumn Header="Bérlő" Width="1.35*" MinWidth="112" Binding="{Binding Berlo.Nev}"
                                                    ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="Ár" Width="78" Binding="{Binding Ar, StringFormat=N0, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Autó ID" Width="68" Binding="{Binding AutoId}"/>
                                <DataGridTextColumn Header="Márka" Width="*" MinWidth="76" Binding="{Binding Auto.Tipus.Marka}"
                                                    ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="Modell" Width="*" MinWidth="82" Binding="{Binding Auto.Tipus.Modell}"
                                                    ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="Kezdő dátum" Width="97" Binding="{Binding KezdoDatum, StringFormat=yyyy.MM.dd}"/>
                                <DataGridTextColumn Header="Vég dátum" Width="97" Binding="{Binding VegDatum, StringFormat=yyyy.MM.dd}"/>
                                <DataGridTextColumn Header="Km" Width="60" Binding="{Binding Km, StringFormat=N0, ConverterCulture=hu-HU}"/>
                                <DataGridTextColumn Header="Hossz (nap)" Width="90" Binding="{Binding Hossz}"/>
                                <DataGridTextColumn Header="Állapot" Width="104" Binding="{Binding Allapot}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"
                                   DataContext="{Binding ElementName=BerlesDataGrid}">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Items.Count, StringFormat={}{0} találat}"/>
                                <TextBlock Style="{StaticResource SelectionCount}"
                                           Text="{Binding SelectedItems.Count, StringFormat={}·  {0} kijelölve}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Törlés" Style="{StaticResource DeleteSelection}" Click="TorolBerles_Click"/>
                                <Button Content="Szerkesztés" Style="{StaticResource EditSelection}" MinWidth="105"
                                        Margin="8,0,0,0" Click="SzerkesztBerles_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Border>
</Window>
