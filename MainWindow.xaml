<Window x:Class="Autokolcsonzo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autókölcsönző" Height="550" Width="900">

    <TabControl Margin="8" SelectionChanged="FoTabControl_SelectionChanged">

        <TabItem Header="Városok">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" >
                    <TextBlock Text="Szűrés:" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Város:" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBox x:Name="VarosNevFilterTextBox" Width="150" Margin="0,0,15,0"
                             TextChanged="VarosFilterTextBox_TextChanged"/>
                    <TextBlock Text="Irányítószám:" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBox x:Name="VarosIranySzamFilterTextBox" Width="76" Margin="0,0,15,0"
                             TextChanged="VarosFilterTextBox_TextChanged"/>
                    <TextBlock Text="Megye:" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBox x:Name="VarosMegyeFilterTextBox" Width="150"
                             TextChanged="VarosFilterTextBox_TextChanged"/>
                </StackPanel>

                <DataGrid x:Name="VarosDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          MouseDoubleClick="VarosDataGrid_MouseDoubleClick" 
                          CanUserResizeColumns="False" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Azonosító"    Binding="{Binding VarosId}"/>
                        <DataGridTextColumn Header="Név"          Binding="{Binding Nev}" Width="*"/>
                        <DataGridTextColumn Header="Irányítószám" Binding="{Binding IranySzam}"/>
                        <DataGridTextColumn Header="Megye"        Binding="{Binding Megye}" Width="*"/>
                        <DataGridTextColumn Header="Bérlők száma" Binding="{Binding Berlok.Count}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Új" Width="90" Margin="0,0,8,0" Click="UjVaros_Click"/>
                    <Button Content="Szerkesztés" Width="90" Margin="0,0,8,0" Click="SzerkesztVaros_Click"/>
                    <Button Content="Törlés" Width="90" Click="TorolVaros_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Típusok">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Márka:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TipusMarkaFilterTextBox" Width="130" Margin="0,0,16,0"
                     TextChanged="TipusFilter_Changed"/>
                    <TextBlock Text="Modell:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TipusModellFilterTextBox" Width="130" Margin="0,0,16,0"
                     TextChanged="TipusFilter_Changed"/>
                    <TextBlock Text="Üzemanyag:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TipusUzemanyagFilterComboBox" Width="120"
                      SelectionChanged="TipusFilter_Changed"/>
                </StackPanel>

                <DataGrid x:Name="TipusDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  MouseDoubleClick="TipusDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Azonosító" Binding="{Binding TipusId}"/>
                        <DataGridTextColumn Header="Márka"     Binding="{Binding Marka}" Width="*"/>
                        <DataGridTextColumn Header="Modell"    Binding="{Binding Modell}" Width="*"/>
                        <DataGridTextColumn Header="Évjárat"   Binding="{Binding Evjarat}"/>
                        <DataGridTextColumn Header="Fogyasztás (/100 km)"
                                    Binding="{Binding Fogyasztas, StringFormat=N1, ConverterCulture=hu-HU}"/>
                        <DataGridTextColumn Header="Üzemanyag" Binding="{Binding Uzemanyag}"/>
                        <DataGridTextColumn Header="Autók száma" Binding="{Binding Autok.Count}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Új" Width="90" Margin="0,0,8,0" Click="UjTipus_Click"/>
                    <Button Content="Szerkesztés" Width="90" Margin="0,0,8,0" Click="SzerkesztTipus_Click"/>
                    <Button Content="Törlés" Width="90" Click="TorolTipus_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Autók">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Márka:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="AutoMarkaFilterTextBox" Width="120" Margin="0,0,16,0"
                     TextChanged="AutoFilter_Changed"/>
                    <TextBlock Text="Modell:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="AutoModellFilterTextBox" Width="120" Margin="0,0,16,0"
                     TextChanged="AutoFilter_Changed"/>
                    <TextBlock Text="Max. napi ár (Ft):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="AutoMaxArFilterTextBox" Width="90"
                     TextChanged="AutoFilter_Changed"/>
                </StackPanel>

                <DataGrid x:Name="AutoDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  MouseDoubleClick="AutoDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Azonosító" Binding="{Binding AutoId}"/>
                        <DataGridTextColumn Header="Márka"     Binding="{Binding Tipus.Marka}" Width="*"/>
                        <DataGridTextColumn Header="Modell"    Binding="{Binding Tipus.Modell}" Width="*"/>
                        <DataGridTextColumn Header="Évjárat"   Binding="{Binding Tipus.Evjarat}"/>
                        <DataGridTextColumn Header="Alap km"   Binding="{Binding AlapKm, StringFormat=N0, ConverterCulture=hu-HU}"/>
                        <DataGridTextColumn Header="Megtett km" Binding="{Binding MegtettKm, StringFormat=N0, ConverterCulture=hu-HU}"/>
                        <DataGridTextColumn Header="Napi ár (Ft)" Binding="{Binding NapiAr, StringFormat=N0, ConverterCulture=hu-HU}"/>
                        <DataGridTextColumn Header="Bérlések" Binding="{Binding Berlesek.Count}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Új" Width="90" Margin="0,0,8,0" Click="UjAuto_Click"/>
                    <Button Content="Szerkesztés" Width="90" Margin="0,0,8,0" Click="SzerkesztAuto_Click"/>
                    <Button Content="Törlés" Width="90" Click="TorolAuto_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>


        <TabItem Header="Bérlők">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Név:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="BerloNevFilterTextBox" Width="160" Margin="0,0,16,0"
                     TextChanged="BerloFilter_Changed"/>
                    <TextBlock Text="Város:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="BerloVarosFilterTextBox" Width="140"
                     TextChanged="BerloFilter_Changed"/>
                </StackPanel>

                <DataGrid x:Name="BerloDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  MouseDoubleClick="BerloDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Azonosító" Binding="{Binding BerloId}"/>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                        <DataGridTextColumn Header="Születési dátum" Binding="{Binding SzulDatum, StringFormat=yyyy.MM.dd}"/>
                        <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor}"/>
                        <DataGridTextColumn Header="Város" Binding="{Binding Varos.Nev}" Width="*"/>
                        <DataGridTextColumn Header="Utca" Binding="{Binding UtcaNev}" Width="*"/>
                        <DataGridTextColumn Header="Házszám" Binding="{Binding HazSzam}"/>
                        <DataGridTextColumn Header="Bérlések" Binding="{Binding Berlesek.Count}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Új" Width="90" Margin="0,0,8,0" Click="UjBerlo_Click"/>
                    <Button Content="Szerkesztés" Width="90" Margin="0,0,8,0" Click="SzerkesztBerlo_Click"/>
                    <Button Content="Törlés" Width="90" Click="TorolBerlo_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <!-- The other tabs ( Bérlések) will be added here later -->

    </TabControl>
</Window>